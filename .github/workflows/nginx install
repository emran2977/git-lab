Name:My Test Workflows


on:
 push:
   branch:
     -Test


jobs:
  apt update and nginx install:
    name: os update and nginx install
      runs on: ubuntu-latest
steps:
 -name: checkout repository
  uses:appleboy/ssh-action
  with:
    host: ${{secrets.EC2}}
    username: ${{secrets.EC2_USER}}
    password: ${{secrets.PASSWORD}}
    port: ${{secrets.PORT}}
    script: |
            echo "GitHub Actions connected at $(date)" > ~/github_test.txt
            mkdir -p ~/test_folder
            ls -la ~

